{
  "name": "bauhaus",
  "version": "4.21.0-rc4",
  "type": "module",
  "description": "Web application for the management of concepts, classifications and other statistical objects",
  "repository": {
    "type": "git",
    "url": "https://github.com/InseeFr/Bauhaus"
  },
  "license": "MIT",
  "author": "INSEE (http://www.insee.fr)",
  "private": true,
  "scripts": {
    "lint": "oxlint -c oxlint.json && npx stylelint \"src/**/*.css\"",
    "test": "vitest",
    "test:coverage": "cross-env CI=true vitest run --coverage",
    "start": "vite",
    "build": "vite build && pnpm create-zip",
    "create-zip": "cd build && bestzip build.zip *",
    "knip": "knip",
    "pre-push": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test:coverage -- --allowOnly false",
    "prepare": "husky",
    "_format": "oxfmt src",
    "format": "pnpm _format",
    "format:check": "pnpm _format --check",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "18.2.79",
      "@types/react-dom": "18.2.25",
      "loader-utils": "2.0.4",
      "shell-quote": "1.8.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "core-js",
      "esbuild",
      "sharp",
      "@oxlint/darwin-universal"
    ]
  },
  "devDependencies": {
    "@bauhaus/ddi-codegen": "workspace:*",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@tanstack/react-devtools": "^0.9.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.9.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/react-draft-wysiwyg": "^1.13.9",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-istanbul": "^4.1.8",
    "bestzip": "^2.2.5",
    "cross-env": "^7.0.3",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.6",
    "knip": "^6.5.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.55.1",
    "storybook": "^10.5.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "7.0.2",
    "vite": "^8.0.16",
    "vite-envs": "^4.6.2",
    "vite-plugin-csp-guard": "^4.0.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.59.20",
    "@textlint/markdown-to-ast": "^15.2.2",
    "@uiw/react-md-editor": "^4.0.11",
    "dayjs": "^1.11.6",
    "dompurify": "3.3.1",
    "draft-js": "0.11.7",
    "draft-js-export-html": "1.4.1",
    "draft-js-import-html": "1.2.1",
    "file-saver": "1.3.3",
    "highlight.js": "^11.11.1",
    "i18next": "^25.5.3",
    "oidc-spa": "^5.3.0",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-draft-wysiwyg": "1.15.0",
    "react-dropzone": "11.0.1",
    "react-i18next": "^16.0.0",
    "react-modal": "^3.14.4",
    "react-router-dom": "6.27.0",
    "react-sliding-side-panel": "1.1.8",
    "zod": "^4.3.6"
  }
}
